# Copiez ce fichier en .env puis choisissez UN fournisseur.
# Fournisseurs gratuits : groq, gemini, mistral, ollama (local, sans clé). Payant : openai.
LLM_PROVIDER=groq

# Clé du fournisseur choisi (une seule suffit)
GROQ_API_KEY=        # https://console.groq.com/keys

# Facultatif : forcer un modèle précis (sinon un modèle par défaut est utilisé)
# LLM_MODEL=openai/gpt-oss-120b
